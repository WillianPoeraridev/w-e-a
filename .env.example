# ── Banco de dados (Neon Postgres) ──────────────────────────────────────────
# Crie um projeto free em https://neon.tech e cole a connection string aqui.
# Formato: postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ── Better Auth ─────────────────────────────────────────────────────────────
# Gere um secret novo com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="troque-por-um-secret-de-32-bytes"
# URL onde o app roda (sem barra no fim)
BETTER_AUTH_URL="http://localhost:3000"

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
